# =============================================================================
# .dockerignore selects source inputs for TokenRouter image builds. Local data,
# credentials, and deployment tooling are excluded from the build context;
# the runtime entrypoint and legal documents remain available to the Dockerfiles
# that copy them into build stages.
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
# admin-compliance gate 的 LegalDocumentView.vue 构建时会导入 docs/legal/*.md?raw。
# docs/ 其他内容仍排除，只把法律文档子树放入 Docker 构建上下文。
!docs/legal/
!docs/legal/*.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# Node modules (will be installed in container)
frontend/node_modules/
node_modules/

# Plugin SDK development dependencies and sample outputs are rebuilt from source;
# exclude them from the backend module copy and the container build context.
plugin-sdk/**/node_modules/
plugin-sdk/**/dist/
plugin-sdk/web/tests/

# Go build cache (will be built in container)
backend/vendor/

# Test files
*_test.go
**/*.test.js
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example

# Local config
config.yaml
config.local.yaml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Only the runtime entrypoint is consumed from the deployment directory.
deploy/*
!deploy/docker-entrypoint.sh

# GoReleaser
.goreleaser.yaml

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md

# Local verification binaries and planning artifacts are not runtime inputs.
# Keep them outside COPY backend and avoid shipping development data to builders.
backend/bin/
backend/server
backend/*.test
backend/data/
.agents/
refactor/
output/
