# =============================================================================
# .env.example supplies deployment variables for Docker Compose and Apple
# Container. Copy it to a private .env file, configure database credentials and
# stable secrets, and review the documented resource limits before starting
# services; application defaults apply where the templates leave values unset.
# =============================================================================
# Copy to .env and adjust the settings:
#   cp .env.example .env
#   chmod 600 .env
#   nano .env
#
# Then start the deployment with Docker Compose or Apple Container:
#   docker compose up -d
#   ./apple-container.sh up
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# IPv4 bind address for host port mappings; the default permits local access
# only.
BIND_HOST=127.0.0.1

# Published host port (Apple Container requires 1025-65535).
SERVER_PORT=8080

# Server mode: release or debug
SERVER_MODE=release

# Optional token used only for update checks through the GitHub Releases API.
# Release asset downloads remain anonymous. GITHUB_TOKEN and GH_TOKEN are not
# used as fallback credentials.
UPDATE_GITHUB_TOKEN=

# Return Server-Timing only for authenticated requests from admin web pages.
ENABLE_SERVER_TIMING=false

# Apple Container image overrides, ignored by Docker Compose. Pin a release
# tag or digest for managed deployments.
APPLE_CONTAINER_TOKENROUTER_IMAGE=ghcr.io/tokenflux/tokenrouter:latest
APPLE_CONTAINER_POSTGRES_IMAGE=postgres:18-alpine
APPLE_CONTAINER_REDIS_IMAGE=redis:8-alpine

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: debug/info/warn/error.
LOG_LEVEL=info
# Log format: json/console.
LOG_FORMAT=json
# Service field included in each log entry.
LOG_SERVICE_NAME=tokenrouter
# Environment field included in each log entry.
LOG_ENV=production
# Include caller location information.
LOG_CALLER=true
# Stack trace threshold: none/error/fatal.
LOG_STACKTRACE_LEVEL=error

# Output destinations; both are recommended inside containers.
# Write logs to stdout/stderr.
LOG_OUTPUT_TO_STDOUT=true
# Write logs to a file.
LOG_OUTPUT_TO_FILE=true
# Log file path; when empty, derive it as follows:
# - DATA_DIR set: ${DATA_DIR}/logs/tokenrouter.log
# - DATA_DIR unset: /app/data/logs/tokenrouter.log
LOG_OUTPUT_FILE_PATH=

# Log rotation settings.
# Maximum size per log file (MB).
LOG_ROTATION_MAX_SIZE_MB=100
# Number of rotated log files to retain; zero disables the limit.
LOG_ROTATION_MAX_BACKUPS=10
# Retention for old log files (days); zero disables the limit.
LOG_ROTATION_MAX_AGE_DAYS=7
# Compress rotated log files.
LOG_ROTATION_COMPRESS=true
# Use local time for rotated log file timestamps.
LOG_ROTATION_LOCAL_TIME=true

# Log sampling to reduce high-frequency duplicate entries.
LOG_SAMPLING_ENABLED=false
# Keep the first N log entries per second without sampling.
LOG_SAMPLING_INITIAL=100
# After that, retain one entry out of every N.
LOG_SAMPLING_THEREAFTER=100

# Global max request body size in bytes (default: 256MB)
# Applies to all requests, especially important for h2c first request memory protection
SERVER_MAX_REQUEST_BODY_SIZE=268435456

# Gateway max request body size in bytes (default: 256MB)
GATEWAY_MAX_BODY_SIZE=268435456

# Enable HTTP/2 Cleartext (h2c) for client connections
SERVER_H2C_ENABLED=true
# H2C max concurrent streams (default: 50)
SERVER_H2C_MAX_CONCURRENT_STREAMS=50
# H2C idle timeout in seconds (default: 75)
SERVER_H2C_IDLE_TIMEOUT=75
# H2C max read frame size in bytes (default: 1048576 = 1MB)
SERVER_H2C_MAX_READ_FRAME_SIZE=1048576
# H2C max upload buffer per connection in bytes (default: 2097152 = 2MB)
SERVER_H2C_MAX_UPLOAD_BUFFER_PER_CONNECTION=2097152
# H2C max upload buffer per stream in bytes (default: 524288 = 512KB)
SERVER_H2C_MAX_UPLOAD_BUFFER_PER_STREAM=524288

# Timezone
TZ=Asia/Shanghai

# Optional mobile Alipay flow. When unset, use the value saved in the admin
# settings.
# Enable only when the official Alipay instance has Face-to-Face Payment
# enabled.
# ALIPAY_MOBILE_PRECREATE_DEEP_LINK=true

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_USER=tokenrouter
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=tokenrouter
# PostgreSQL listening port for the server and application connections
# (default 5432).
DATABASE_PORT=5432

# -----------------------------------------------------------------------------
# PostgreSQL Server Settings (Optional)
# -----------------------------------------------------------------------------
# POSTGRES_SHM_SIZE limits /dev/shm in the PostgreSQL container, where
# parallel queries allocate dynamic shared memory.
# The Docker default of 64 MiB is small for large-table aggregation. Use at
# least 1 GiB in production.
POSTGRES_SHM_SIZE=1gb
# POSTGRES_MAX_CONNECTIONS limits the number of connections accepted by
# PostgreSQL.
# Allow at least the sum of DATABASE_MAX_OPEN_CONNS across all TokenRouter
# instances, plus headroom such as 20%.
POSTGRES_MAX_CONNECTIONS=512
# POSTGRES_SHARED_BUFFERS sets shared memory used by PostgreSQL to cache data
# pages.
# A common starting range is 10%-25% of physical memory; account for the
# actual container memory limit.
# Example for a container with 8 GB of memory: 1 GB.
POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE tells the query planner how much cache is
# expected to be available; it does not allocate that memory.
# A common starting range is 50%-75% of physical memory.
# Example for a container with 8 GB of memory: 6 GB.
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
# POSTGRES_MAINTENANCE_WORK_MEM limits memory for maintenance operations such
# as VACUUM and CREATE INDEX.
# Larger values can speed up maintenance at the cost of additional memory.
# Example for a container with 8 GB of memory: 128 MB.
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# -----------------------------------------------------------------------------
# PostgreSQL Connection Pool Settings (Optional)
# -----------------------------------------------------------------------------
# Pool sizing:
# - These settings size the connection pool from TokenRouter to PostgreSQL;
#   they do not set PostgreSQL max_connections.
# - Across replicas, the total connection ceiling is approximately the
#   instance count multiplied by DATABASE_MAX_OPEN_CONNS.
# - Oversized pools can exhaust database connections, increase memory use and
#   context switching, and reduce performance.
# - Tune gradually against PostgreSQL max_connections and available resources.
#   Keeping the combined application limit within 50%-80% of max_connections
#   leaves room for other clients.
#
# DATABASE_MAX_OPEN_CONNS limits active plus idle connections. Requests wait
# for a connection when the pool reaches this limit.
# A typical range is 50-500, depending on database resources, replica count,
# and query complexity.
DATABASE_MAX_OPEN_CONNS=256
# DATABASE_MAX_IDLE_CONNS limits warm idle connections; keep it at or below
# DATABASE_MAX_OPEN_CONNS.
# Too few idle connections increase connection setup latency; too many retain
# database resources unnecessarily.
DATABASE_MAX_IDLE_CONNS=128
# DATABASE_CONN_MAX_LIFETIME_MINUTES limits the lifetime of each connection in
# minutes.
# Periodic replacement reduces problems with long-lived connections through
# middleware, load balancers, NAT, or server restarts.
# Zero disables the limit, which is generally not recommended in production.
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
# DATABASE_CONN_MAX_IDLE_TIME_MINUTES limits how long a connection may remain
# idle, in minutes.
# Idle connections beyond this age are reclaimed so unused connections do not
# keep consuming pool capacity.
# Zero disables the limit, which is generally not recommended in production.
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis listening port for the server and application connections (default
# 6379).
REDIS_PORT=6379
# Redis ACL username; leave empty to use the default user.
REDIS_USERNAME=
# Leave empty for no password (default for local development)
REDIS_PASSWORD=
REDIS_DB=0
# Redis data memory soft limit. Keep it below the 2 GiB Compose container
# limit to leave room for persistence and client buffers.
REDIS_MAXMEMORY=1536mb
# Reject new writes at the soft limit to avoid evicting locks, sessions,
# rate-limit state, or other critical data.
REDIS_MAXMEMORY_POLICY=noeviction
# Maximum client connections accepted by Redis (optional).
REDIS_MAXCLIENTS=50000
# Redis connection pool size (application default 1024).
REDIS_POOL_SIZE=4096
# Minimum idle Redis connections (application default 10).
REDIS_MIN_IDLE_CONNS=256
REDIS_ENABLE_TLS=false

# -----------------------------------------------------------------------------
# Admin Account
# -----------------------------------------------------------------------------
# Email for the admin account
ADMIN_EMAIL=admin@tokenrouter.local

# Password for admin account
# Leave empty to auto-generate (will be shown in logs on first run)
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Set a fixed JWT_SECRET to prevent login sessions from being
# invalidated after container restarts. If left empty, a random secret will
# be generated on each startup, causing all users to be logged out.
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOUR=24
# Access token lifetime (minutes).
# Precedence:
# - >0: use this lifetime in minutes instead of JWT_EXPIRE_HOUR.
# - =0: fall back to JWT_EXPIRE_HOUR.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0

# -----------------------------------------------------------------------------
# Initial Setup Configuration
# -----------------------------------------------------------------------------
# Database migration timeout during initial setup, in seconds.
# Zero selects the built-in default of 60 seconds.
SETUP_MIGRATION_TIMEOUT_SECONDS=0

# -----------------------------------------------------------------------------
# TOTP (2FA) Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Set a fixed encryption key for TOTP secrets. If left empty, a
# random key will be generated on each startup, causing all existing TOTP
# configurations to become invalid (users won't be able to login with 2FA).
# Generate a secure key: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Configuration File (Optional)
# -----------------------------------------------------------------------------
# Path to custom config file (relative to docker-compose.yml directory)
# Copy config.example.yaml to config.yaml and modify as needed
# Leave unset to use default ./config.yaml
#CONFIG_FILE=./config.yaml

# -----------------------------------------------------------------------------
# Built-in OAuth Client Secrets (Optional)
# -----------------------------------------------------------------------------
# SECURITY NOTE:
# - Third-party OAuth client secrets are not embedded in this repository.
# - To use a built-in client instead of your own OAuth client, supply its
# secret through the runtime environment.
#
# Gemini CLI built-in OAuth client_secret for the Gemini
# code_assist/google_one login flows.
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
#
# Antigravity OAuth client_secret for the Antigravity OAuth login flow.
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
#
# Antigravity User-Agent version. The admin antigravity_user_agent_version
# setting takes precedence; leave empty for the built-in default 1.23.2.
# ANTIGRAVITY_USER_AGENT_VERSION=

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
# Cooldown time (in minutes) when upstream returns 529 (overloaded)
RATE_LIMIT_OVERLOAD_COOLDOWN_MINUTES=10

# -----------------------------------------------------------------------------
# Gateway Scheduling (Optional)
# Scheduler cache and controlled database fallback. Ready cache hits do not
# query the database.
# -----------------------------------------------------------------------------
# Force Codex CLI mode: treat all /openai/v1/responses requests as Codex CLI.
# Use this fallback when an intermediary drops or rewrites User-Agent before
# forwarding the request to TokenRouter.
#
# Enabling this changes behavior for every client, including clients other
# than VS Code and Codex CLI.
#
# Default: false.
GATEWAY_FORCE_CODEX_CLI=false
# OpenAI/Codex upstream response header timeout (seconds); zero disables the
# local response-header timeout.
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
# Force all OpenAI Responses upstream requests to use HTTP/SSE instead of
# WebSocket.
# Set true if proxy or network problems cause repeated upstream WebSocket
# reconnects. This does not disable HTTP/2.
# To switch to HTTP/1.1, separately set GATEWAY_OPENAI_HTTP2_ENABLED=false.
# Save this in a persistent .env file so it is read again at startup after
# image updates or container recreation.
GATEWAY_OPENAI_WS_FORCE_HTTP=false
# OpenAI HTTP upstreams use HTTP/2 by default; set false for an emergency
# rollback to HTTP/1.1.
GATEWAY_OPENAI_HTTP2_ENABLED=true
GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_FAILURE_THRESHOLD=2
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_WINDOW_SECONDS=60
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_TTL_SECONDS=600
# Upstream connections per host (default 1024). Streaming or HTTP/1.1
# workloads may need larger values, such as 2400 or 4096.
GATEWAY_MAX_CONNS_PER_HOST=2048
# Total idle upstream connections (default 2560). High concurrency with
# provider or proxy isolation may need a larger pool.
GATEWAY_MAX_IDLE_CONNS=8192
# Idle upstream connections per host (default 120).
GATEWAY_MAX_IDLE_CONNS_PER_HOST=4096
# Maximum waiting queue length for sticky sessions.
GATEWAY_SCHEDULING_STICKY_SESSION_MAX_WAITING=3
# Sticky-session wait timeout as a duration, such as 45s.
GATEWAY_SCHEDULING_STICKY_SESSION_WAIT_TIMEOUT=120s
# Fallback queue wait timeout as a duration, such as 30s.
GATEWAY_SCHEDULING_FALLBACK_WAIT_TIMEOUT=30s
# Maximum fallback queue length.
GATEWAY_SCHEDULING_FALLBACK_MAX_WAITING=100
# Enable batch load calculations for scheduling.
GATEWAY_SCHEDULING_LOAD_BATCH_ENABLED=true
# Concurrency slot cleanup interval as a duration, such as 30s.
GATEWAY_SCHEDULING_SLOT_CLEANUP_INTERVAL=30s
# Allow controlled database fallback (default true, retaining existing
# behavior).
GATEWAY_SCHEDULING_DB_FALLBACK_ENABLED=true
# Controlled database fallback timeout (seconds); zero adds no tighter
# timeout.
GATEWAY_SCHEDULING_DB_FALLBACK_TIMEOUT_SECONDS=0
# Controlled database fallback rate limit (queries per second per instance);
# zero disables the limit.
GATEWAY_SCHEDULING_DB_FALLBACK_MAX_QPS=0
# Outbox polling interval (seconds).
GATEWAY_SCHEDULING_OUTBOX_POLL_INTERVAL_SECONDS=1
# Outbox lag warning threshold (seconds).
GATEWAY_SCHEDULING_OUTBOX_LAG_WARN_SECONDS=5
# Outbox lag threshold that forces a snapshot rebuild (seconds).
GATEWAY_SCHEDULING_OUTBOX_LAG_REBUILD_SECONDS=10
# Consecutive outbox lag observations required to trigger a rebuild.
GATEWAY_SCHEDULING_OUTBOX_LAG_REBUILD_FAILURES=3
# Outbox backlog size that triggers a rebuild (rows).
GATEWAY_SCHEDULING_OUTBOX_BACKLOG_REBUILD_ROWS=10000
# Full snapshot rebuild interval (seconds).
GATEWAY_SCHEDULING_FULL_REBUILD_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Image Generation Keepalive & Concurrency (Optional)
# -----------------------------------------------------------------------------
# Image stream upstream data interval timeout (seconds). Zero disables it;
# otherwise use 60-1800.
GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
# Image stream keepalive interval (seconds). Zero disables it; otherwise use
# 5-60.
GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
# Keepalive interval for non-streaming image JSON responses (seconds). The
# default zero disables it; the first heartbeat commits HTTP status 200.
GATEWAY_IMAGE_NONSTREAM_KEEPALIVE_INTERVAL=0
# Enable the per-process image generation concurrency limit. The default false
# retains existing behavior.
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
# Maximum concurrent image generation requests in this process. Zero disables
# the limit.
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
# Image concurrency overflow policy: reject returns HTTP 429; wait queues for
# an available slot.
GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=reject
# Maximum wait for an image concurrency slot in wait mode (seconds).
GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30
# Maximum queued image requests in this process in wait mode. Zero disables
# the waiting queue limit.
GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100
# -----------------------------------------------------------------------------
# Dashboard Aggregation (Optional)
# -----------------------------------------------------------------------------
# Enable aggregation job
DASHBOARD_AGGREGATION_ENABLED=true
# Refresh interval (seconds)
DASHBOARD_AGGREGATION_INTERVAL_SECONDS=60
# Lookback window (seconds)
DASHBOARD_AGGREGATION_LOOKBACK_SECONDS=120
# Allow manual backfill
DASHBOARD_AGGREGATION_BACKFILL_ENABLED=false
# Backfill max range (days)
DASHBOARD_AGGREGATION_BACKFILL_MAX_DAYS=31
# Recompute recent N days on startup
DASHBOARD_AGGREGATION_RECOMPUTE_DAYS=2
# Retention windows (days)
DASHBOARD_AGGREGATION_RETENTION_USAGE_LOGS_DAYS=90
DASHBOARD_AGGREGATION_RETENTION_HOURLY_DAYS=180
DASHBOARD_AGGREGATION_RETENTION_DAILY_DAYS=730

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# URL Allowlist Configuration
# Enable URL allowlist validation. False skips the allowlist and performs only
# basic URL format validation.
SECURITY_URL_ALLOWLIST_ENABLED=false

# Allow HTTP URLs when the allowlist is disabled (default true). False permits
# only HTTPS URLs.
# HTTP transfers data in plaintext. Set false in production when upstreams
# support HTTPS.
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true

# Allow localhost/private IPs for upstream/pricing/CRS (use only in trusted networks)
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true

# -----------------------------------------------------------------------------
# Gemini OAuth (Optional, Required Only for Gemini OAuth Providers)
# -----------------------------------------------------------------------------
# TokenRouter supports TWO Gemini OAuth modes:
#
# 1. Code Assist OAuth (requires GCP project_id)
#    - Uses: cloudcode-pa.googleapis.com (Code Assist API)
#    - Auto scopes: cloud-platform + userinfo.email + userinfo.profile
#    - OAuth Client: Can use the built-in Gemini CLI client (leave the
# settings empty).
#    - Requires: Google Cloud Platform project with Code Assist enabled
#
# 2. AI Studio OAuth (no project_id required)
#    - Uses: generativelanguage.googleapis.com (AI Studio API)
#    - Default scopes: generative-language
#    - OAuth Client: Requires your own OAuth 2.0 client; the built-in Gemini
# CLI client cannot request the generative-language scope.
#    - Requires: Create OAuth 2.0 Client in GCP Console + OAuth consent screen
#    - Setup Guide: https://ai.google.dev/gemini-api/docs/oauth
#    - IMPORTANT: Publish the OAuth client in Production mode.
#      Testing mode permits only 100 test users, and refresh tokens expire
# after seven days.
#      Publish through GCP Console > OAuth consent screen > PUBLISH APP.
#
# Configuration:
# Leave empty to use the built-in Gemini CLI OAuth client (Code Assist OAuth only).
# To enable AI Studio OAuth, set your own OAuth client ID/secret here.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# Optional; leave empty to auto-select scopes based on oauth_type
GEMINI_OAUTH_SCOPES=

# -----------------------------------------------------------------------------
# Gemini Quota Policy (OPTIONAL, local simulation)
# -----------------------------------------------------------------------------
# JSON overrides for local quota simulation (Code Assist only).
# Example:
# GEMINI_QUOTA_POLICY={"tiers":{"LEGACY":{"pro_rpd":50,"flash_rpd":1500,"cooldown_minutes":30},"PRO":{"pro_rpd":1500,"flash_rpd":4000,"cooldown_minutes":5},"ULTRA":{"pro_rpd":2000,"flash_rpd":0,"cooldown_minutes":5}}}
GEMINI_QUOTA_POLICY=

# -----------------------------------------------------------------------------
# Ops Monitoring Configuration
# -----------------------------------------------------------------------------
# Enable ops monitoring features (background jobs and APIs)
# Set to false to hide ops menu in sidebar and disable all ops features
OPS_ENABLED=true

# -----------------------------------------------------------------------------
# Update Configuration
# -----------------------------------------------------------------------------
# Proxy URL for accessing GitHub (used for online updates and pricing data)
# Supports: http, https, socks5, socks5h
# Examples:
#   HTTP proxy: http://127.0.0.1:7890
#   SOCKS5 proxy: socks5://127.0.0.1:1080
#   With authentication: http://user:pass@proxy.example.com:8080
# Leave empty for a direct connection.
UPDATE_PROXY_URL=

# Map existing volumes explicitly when switching Compose templates. These
# overrides are unnecessary when updating an image with the original template.
TOKENROUTER_DATA_VOLUME=
TOKENROUTER_POSTGRES_VOLUME=
TOKENROUTER_REDIS_VOLUME=

# Plugin process availability and optional package distribution overrides.
PLUGINS_ENABLED=true
PLUGINS_DIR=
PLUGINS_OFFICIAL_INDEX_URL=
PLUGINS_MAX_RUNNING=20
PLUGINS_DOWNLOAD_PROXY=
PLUGINS_DOWNLOAD_URL_PREFIX=
PLUGINS_PLUGIN_HTTP_PROXY=
PLUGINS_DEV_MODE=false
PLUGINS_DEV_DIRS=
