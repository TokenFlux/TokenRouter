# .env.example supplies Compose controls, first-installation inputs, and secrets
# explicitly referenced by config.yaml. Copy it to .env with mode 600 before
# starting services. After installation, edit the persisted config.yaml for
# application settings; these variables do not implicitly override that file.
#
# cp .env.example .env
# chmod 600 .env
# docker compose up -d

# Container ports, resources, images, and existing volume names.
APPLE_CONTAINER_POSTGRES_IMAGE=postgres:18-alpine
APPLE_CONTAINER_REDIS_IMAGE=redis:8-alpine
APPLE_CONTAINER_TOKENROUTER_IMAGE=ghcr.io/tokenflux/tokenrouter:latest
BIND_HOST=127.0.0.1
POSTGRES_DB=tokenrouter
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=512
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_SHM_SIZE=1gb
POSTGRES_USER=tokenrouter
REDIS_MAXCLIENTS=50000
REDIS_MAXMEMORY=1536mb
REDIS_MAXMEMORY_POLICY=noeviction
TOKENROUTER_DATA_VOLUME=
TOKENROUTER_POSTGRES_VOLUME=
TOKENROUTER_REDIS_VOLUME=

# First-installation inputs and referenced credential values.
ADMIN_EMAIL=admin@tokenrouter.local
ADMIN_PASSWORD=
DATABASE_PASSWORD=
DATABASE_PORT=5432
JWT_EXPIRE_HOUR=24
JWT_SECRET=
REDIS_DB=0
REDIS_ENABLE_TLS=false
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_USERNAME=
SERVER_MODE=release
SERVER_PORT=8080
SETUP_MIGRATION_TIMEOUT_SECONDS=0
TOTP_ENCRYPTION_KEY=
TZ=Asia/Shanghai

# Optional secrets used only by explicit ${VAR} references in config.yaml.
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
DINGTALK_CONNECT_CLIENT_SECRET=
GEMINI_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRET=
LINUXDO_CONNECT_CLIENT_SECRET=
OIDC_CONNECT_CLIENT_SECRET=
PAYMENT_RESUME_SIGNING_KEY=
PLUGINS_DOWNLOAD_PROXY=
PLUGINS_PLUGIN_HTTP_PROXY=
UPDATE_GITHUB_TOKEN=
UPDATE_PROXY_URL=
WECHAT_CONNECT_APP_SECRET=
WECHAT_CONNECT_MOBILE_APP_SECRET=
WECHAT_CONNECT_MP_APP_SECRET=
WECHAT_CONNECT_OPEN_APP_SECRET=
WECHAT_OAUTH_MP_APP_SECRET=
WECHAT_OAUTH_OPEN_APP_SECRET=
YESCAPTCHA_API_KEY=
YESCAPTCHA_CLIENT_KEY=
