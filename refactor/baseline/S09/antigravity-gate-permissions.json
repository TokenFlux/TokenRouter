{
  "s09-account-antigravity-authorization": {
    "list-mode": "strict",
    "files": [
      "**/internal/account/antigravity_authorization.go"
    ],
    "allow": [
      "$gostd",
      "github.com/TokenFlux/TokenRouter/internal/account$",
