        "desc": "按职责禁止该依赖；使用纯契约或由外层适配。"
      },
      {
        "pkg": "database/sql",
        "desc": "按职责禁止该依赖；使用纯契约或由外层适配。"
      },
      {
        "pkg": "net/rpc",
        "desc": "按职责禁止该依赖；使用纯契约或由外层适配。"
      }
    ]
  },
  "s09-account-qoder-authorization-provider": {
